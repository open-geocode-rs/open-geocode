namespace open_geocode {

enum RecordLayer : u8 : 4 {
    Address,
    Country,
    District,
    Interpolation,
    Locality,
    Neighbourhood,
    Place,
    Postcode,
    Region,
    Street,
}

enum SourceObject : u8 : 2 {
    Node,
    Way,
    Relation,
    Derived,
}

enum GeometryType : u8 : 2 {
    Point,
    LineString,
}

enum LocationPrecisionCode : u8 : 2 {
    Point,
    Centroid,
}

struct StoredRecord {
    layer : RecordLayer : 4;
    source_object : SourceObject : 2;
    geometry_type : GeometryType : 2;
    location_precision : LocationPrecisionCode : 2;
    reserved : u8 : 6;

    source_object_id : i64 : 64;
    derived_record_count : u64 : 64;

    display_lon : i64 : 64;
    display_lat : i64 : 64;

    interpolation_start : u32 : 32;
    interpolation_end : u32 : 32;
    interpolation_step : u32 : 32;

    id_start : u64 : 64;
    id_len : u32 : 32;
    label_start : u64 : 64;
    label_len : u32 : 32;
    name_start : u64 : 64;
    name_len : u32 : 32;

    number_start : u64 : 64;
    number_len : u32 : 32;
    street_start : u64 : 64;
    street_len : u32 : 32;
    place_start : u64 : 64;
    place_len : u32 : 32;
    unit_start : u64 : 64;
    unit_len : u32 : 32;
    locality_start : u64 : 64;
    locality_len : u32 : 32;
    region_start : u64 : 64;
    region_len : u32 : 32;
    postcode_start : u64 : 64;
    postcode_len : u32 : 32;
    country_start : u64 : 64;
    country_len : u32 : 32;

    place_type_start : u64 : 64;
    place_type_len : u32 : 32;
    interpolation_type_start : u64 : 64;
    interpolation_type_len : u32 : 32;
    anchor_ids_start : u64 : 64;
    anchor_ids_len : u32 : 32;
    derived_from_start : u64 : 64;
    derived_from_len : u32 : 32;

    geometry_start : u64 : 64;
    geometry_len : u32 : 32;
}

archive RecordsArchive {
    records: vector<StoredRecord>;
    strings: raw_data;
    geometries: raw_data;
}

} // namespace open_geocode
