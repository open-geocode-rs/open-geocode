    "/reverse": {
      "get": {
        "description": "Returns the nearest address or street to a point, followed by the areas\nthat contain the point, most precise first. Only the first result carries\n`distance_m`.",
        "operationId": "reverse",
        "parameters": [
          {
            "description": "Longitude in degrees.",
            "example": -79.3832,
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "format": "double",
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            }
          },
          {
            "description": "Latitude in degrees.",
            "example": 43.6532,
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "format": "double",
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReverseCollection"
                }
              }
            },
            "description": "Results at the point, most precise first. `features` is empty when nothing is near.",
            "headers": {
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`lon` or `lat` is missing or out of range.",
            "headers": {
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed. The route accepts `GET` only.",
            "headers": {
              "Allow": {
                "description": "Methods the route accepts.",
                "schema": {
                  "example": "GET",
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal server error.",
            "headers": {
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Reverse geocode a point",
        "tags": [
          "geocoding"
        ]
      }
    },
    "/search": {
      "get": {
        "description": "Geocodes free-form text, such as a full address, to coordinates. Results\nare sorted by `score`, highest first.",
        "operationId": "search",
        "parameters": [
          {
            "description": "Text to geocode, such as a full address.",
            "example": "10 King Street, Toronto",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Maximum number of results. `0`, the default, lets the server choose.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "maximum": 50,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Return only results of this layer. An unknown layer returns `400`.",
            "in": "query",
            "name": "layer",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Layer"
            }
          },
          {
            "description": "Return only results in these countries, as comma-separated ISO 3166-1 alpha-2 codes. A code that is not two letters returns `400`. A code the Pack does not cover returns no results.",
            "example": "NZ,AU",
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Point to prefer results near, as `lon,lat`. Breaks ties between equally good matches only.",
            "example": "-79.38,43.65",
            "in": "query",
            "name": "focus",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return only results inside this box, as `min_lon,min_lat,max_lon,max_lat`. The box cannot cross the antimeridian.",
            "example": "-79.64,43.58,-79.12,43.86",
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForwardCollection"
                }
              }
            },
            "description": "Matching results, highest `score` first.",
            "headers": {
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`q` is empty or too long, `limit` is too large, `focus` or `bbox` is out of range, or a parameter is malformed.",
            "headers": {
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed. The route accepts `GET` only.",
            "headers": {
              "Allow": {
                "description": "Methods the route accepts.",
                "schema": {
                  "example": "GET",
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal server error.",
            "headers": {
              "X-Request-Id": {
                "description": "ID the request is logged under: the request's own `X-Request-Id` when it sent one. Include it in bug reports.",
                "schema": {
                  "maxLength": 128,
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Search addresses",
        "tags": [
          "geocoding"
        ]
      }
    }
  },
